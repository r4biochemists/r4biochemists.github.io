library(BiocManager)
library(drawProteins)
library(ggplot2)
prot<-drawProteins::get_features("Q04206") #signed the information of protein PODPS1 to variable prot
prot_dataframe<-drawProteins::feature_to_dataframe(prot) # dataframe that contains (between others) the protein domains
prot_plot<-draw_canvas(prot_dataframe)
prot_plot<-draw_chains(prot_plot, prot_dataframe,label_chains=TRUE) # indicates the protein name
prot_plot<-draw_domains(prot_plot,prot_dataframe)
prot_plot<-draw_regions(prot_plot, prot_dataframe) +
theme(axis.ticks = element_blank(), axis.text.y = element_blank())
prot_plot<-prot_plot + theme_bw(base_size = 20) +
