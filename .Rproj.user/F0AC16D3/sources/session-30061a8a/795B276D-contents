### What about `regexpr()`?

```{r}
# regexpr() returns the position where the match begins.
# The match length is stored as an attribute.
# Here we search for headers containing the word "DNA".
r <- regexpr(pattern = "(.*)DNA(.*)", text = fastanames[1:200])
r

# Which elements had a match?
dna <- which(r > 0, arr.ind = TRUE)
dna

# Extract the length of each match.
dna.length <- attr(r, "match.length")[dna]

# Extract matched headers with a loop.
nombres <- list()
for (i in seq_along(dna)) {
  nombres[[i]] <- substr(fastanames[dna[i]], 1, dna.length[i])
}
head(nombres)
```

